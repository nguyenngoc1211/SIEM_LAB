FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    HF_HOME=/models

WORKDIR /app
COPY requirements-reranker.txt .
RUN pip install --no-cache-dir -r requirements-reranker.txt
COPY src ./src

EXPOSE 8001
CMD ["uvicorn", "mitre_mapper.reranker_server:app", "--host", "0.0.0.0", "--port", "8001"]
