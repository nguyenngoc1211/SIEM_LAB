{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Baseline mapping result",
  "type": "object",
  "required": [
    "schema_version",
    "strategy",
    "scenario_id",
    "mapping_status",
    "primary_mapping",
    "alternative_candidates",
    "candidate_trace",
    "latency_ms",
    "details"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "strategy": {"type": "string"},
    "scenario_id": {"type": ["string", "null"]},
    "mapping_status": {
      "type": "string",
      "enum": [
        "mapped",
        "uncertain",
        "insufficient_evidence",
        "invalid_output",
        "skipped",
        "error"
      ]
    },
    "primary_mapping": {
      "type": ["object", "null"],
      "properties": {
        "technique_id": {"type": "string"},
        "name": {"type": "string"},
        "confidence": {"type": "number"}
      },
      "required": ["technique_id", "name", "confidence"]
    },
    "alternative_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["technique_id", "name", "confidence", "rejection_reason"],
        "properties": {
          "technique_id": {"type": "string"},
          "name": {"type": "string"},
          "confidence": {"type": "number"},
          "rejection_reason": {"type": "string"}
        }
      }
    },
    "candidate_trace": {"type": "array", "items": {"type": "object"}},
    "latency_ms": {"type": "number"},
    "details": {"type": "object"}
  }
}
