alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB Repository Metadata Enumeration"; flow:established,to_server; http.uri; pcre:"/^\/(?:\.git|\.svn|\.hg|\.env|config|settings)/i"; detection_filter:track by_src,count 4,seconds 15; metadata:owasp_crs_rule 930130, owasp_crs_ver 4.29.0, owasp_crs_strength literal; classtype:misc-activity; sid:1002028; rev:1;)
