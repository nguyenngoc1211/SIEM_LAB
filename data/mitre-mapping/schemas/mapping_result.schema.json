{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.soc/schemas/mapping_result.schema.json",
  "title": "ATT&CK mapping result",
  "type": "object",
  "required": [
    "mapping_status",
    "primary_mapping",
    "supporting_evidence",
    "contradictory_evidence",
    "alternative_candidates",
    "candidate_trace",
    "pipeline"
  ],
  "properties": {
    "mapping_status": {"enum": ["mapped", "uncertain", "insufficient_evidence"]},
    "primary_mapping": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["technique_id", "name", "confidence"],
          "properties": {
            "technique_id": {"type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      ]
    },
    "supporting_evidence": {"type": "array"},
    "contradictory_evidence": {"type": "array"},
    "alternative_candidates": {"type": "array"},
    "candidate_trace": {"type": "array"},
    "pipeline": {"type": "object"}
  },
  "additionalProperties": true
}
