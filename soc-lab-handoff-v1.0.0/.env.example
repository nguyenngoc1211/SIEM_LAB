# Mặc định chỉ cho phép truy cập từ chính máy chủ.
# Để truy cập từ mạng lab, thay bằng IP private cụ thể của máy chủ.
LAB_BIND_IP=127.0.0.1
LAB_PORT=8081

# Các tag dưới đây thuận tiện cho lab nhưng chưa bất biến.
# Trước khi bàn giao môi trường ổn định, hãy pin digest theo docs/PRODUCTION_READINESS.md.
JUICE_SHOP_IMAGE=bkimminich/juice-shop:latest
NGINX_IMAGE=nginx:alpine
SURICATA_IMAGE=jasonish/suricata:7.0

SURICATA_INTERFACE=eth0
RULE_UPDATE_INTERVAL=86400
RULE_UPDATE_ENABLED=false
