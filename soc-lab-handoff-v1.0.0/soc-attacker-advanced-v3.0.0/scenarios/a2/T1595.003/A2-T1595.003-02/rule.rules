alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB Backup Artifact Enumeration"; flow:established,to_server; http.uri; pcre:"/(?:backup|site|database|dump|www|archive).*(?:zip|gz|bak|sql|old)/i"; detection_filter:track by_src,count 4,seconds 15; metadata:owasp_crs_rule 920440, owasp_crs_ver 4.29.0, owasp_crs_strength literal; classtype:misc-activity; sid:1002027; rev:1;)
