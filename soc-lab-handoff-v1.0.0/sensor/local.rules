# SOC Attack Scenarios v2 behavioral rules.
# SID namespace 1001001-1001099 is reserved for v2.
# Ground-truth headers and /__soc_attack_marker__ are intentionally absent.

alert tcp any any -> any [22,23,53,443,8080,9200,55000] (msg:"SOC LAB V2 network service discovery"; flags:S; flow:stateless; detection_filter:track by_src,count 4,seconds 10; classtype:network-scan; metadata:mitre_technique_id T1046, mitre_tactic_id TA0007; sid:1001001; rev:2;)

alert http any any -> any any (msg:"SOC LAB V2 web resource enumeration burst"; flow:established,to_server; http.uri; pcre:"/^\/(?:admin(?:istrator)?|api(?:\/|$)|swagger|openapi|api-docs|\.env|\.git|backup|config|debug|metrics|server-status|actuator|graphql|database|dump)/i"; detection_filter:track by_src,count 6,seconds 20; classtype:web-application-activity; metadata:mitre_technique_id T1595.002, mitre_tactic_id TA0043; sid:1001002; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 automated scanner fingerprint"; flow:established,to_server; http.header; pcre:"/(?:User-Agent\x3a\s*(?:sqlmap|Nikto|Nmap Scripting Engine)|X-Scanner\x3a)/i"; classtype:network-scan; metadata:mitre_technique_id T1595.002, mitre_tactic_id TA0043; sid:1001003; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 path traversal attempt"; flow:established,to_server; http.uri.raw; pcre:"/(?:\.\.\/|%2e%2e(?:%2f|\/)|%252e%252e%252f)/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001004; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 Linux LFI attempt"; flow:established,to_server; http.uri.raw; pcre:"/(?:etc(?:\/|%2f|%252f)passwd)/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001005; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 SQL injection boolean or syntax probe"; flow:established,to_server; http.uri; pcre:"/(?:'\s*(?:or|and)\s*'?\w+|\b(?:or|and)\s+\d+\s*=\s*\d+)/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001006; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 SQL injection UNION probe"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; within:128; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001007; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 SQL injection time-delay probe"; flow:established,to_server; http.uri; pcre:"/(?:sleep\s*\(|pg_sleep\s*\(|waitfor\s+delay)/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001008; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 obfuscated SQL injection"; flow:established,to_server; http.uri.raw; pcre:"/(?:%2527.*(?:or|union)|%2f%2a[^?]{0,80}%2a%2f(?:union|select))/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001009; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 cross-site scripting attempt"; flow:established,to_server; http.uri.raw; pcre:"/(?:<|%3c)(?:script|svg|img|input)\b|(?:onerror|onload|onfocus)(?:=|%3d)/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001010; rev:1;)

alert http any any -> any any (msg:"SOC LAB V2 command injection attempt"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/lab/command"; http.request_body; pcre:"/(?:\x3b|\x7c|&&)\s*(?:whoami|echo)\b/i"; classtype:web-application-attack; metadata:mitre_technique_id T1190, mitre_tactic_id TA0001; sid:1001011; rev:2;)

