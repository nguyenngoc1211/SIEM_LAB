alert http $EXTERNAL_NET any -> $HOME_NET any (msg:"LAB Authentication Endpoint Request Surge"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/lab/auth/json"; detection_filter:track by_src,count 10,seconds 60; metadata:owasp_crs_rule 912170, owasp_crs_ver 3.3.7, owasp_crs_strength semantic; classtype:misc-activity; sid:1002054; rev:1;)
